---
import {Image} from "astro:assets";

import portrait from "@src/assets/images/kez-armstrong-portrait.jpg";
import ContactPanel from "@src/components/contact-panel/ContactPanel.astro";
import {services} from "@src/content/Services";
import BaseLayout from "@src/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Kez Armstrong"
  description="Specialist ornithologist and ecological consultant offering avian research, GIS, bird-ringing training and ecological reporting across Ireland."
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Ornithologist · Ecological consultant · Researcher</p>
      <h1>Field knowledge, thoughtfully applied.</h1>
      <p class="lede">
        Specialist in avian research, GIS, bird-ringing training and ecological reporting, based on the island
        of Ireland.
      </p>
      <div class="button-row">
        <a class="button" href="/services/">
          Explore services
        </a>
        <a class="text-link" href="/contact/">
          Discuss a project <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="hero-portrait">
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt="Kez Armstrong smiling outdoors in field clothing"
          widths={[480, 720, 960]}
          sizes="(max-width: 760px) 90vw, 42vw"
          format="avif"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span>Based on the island of Ireland</span>
      </figcaption>
    </figure>
  </section>

  <section class="proof-band" aria-label="Experience highlights">
    <div class="shell proof-grid">
      <p>
        <strong>PhD</strong>
        <span>Raptor ecology</span>
      </p>
      <p>
        <strong>MCIEEM</strong>
        <span>Chartered Institute member</span>
      </p>
      <p>
        <strong>BTO</strong>
        <span>Bird-ringing trainer</span>
      </p>
      <p>
        <strong>County Down</strong>
        <span>Regional representative</span>
      </p>
    </div>
  </section>

  <section class="page-section shell introduction">
    <div>
      <p class="eyebrow">A practical perspective</p>
      <h2>Research depth meets field experience.</h2>
    </div>
    <div class="prose">
      <p>
        As President of <a href="https://www.thecbo.org.uk/">Copeland Bird Observatory</a>, the{" "}
        <a href="https://www.bto.org/community/regional-network">BTO Regional Representative</a> for County
        Down, a BTO bird-ringing trainer, and holding a PhD focused on raptor ecology, I have extensive
        experience in ornithological research, fieldwork and reporting.
      </p>
      <p>
        I offer bespoke freelance solutions for specialist ornithological surveying, bird-ringing
        demonstrations and training, technical report writing, and peer reviewing.
      </p>
    </div>
  </section>

  <section class="services-preview">
    <div class="shell">
      <header class="section-heading">
        <div>
          <p class="eyebrow">How I can help</p>
          <h2>Specialist support for ecological work.</h2>
        </div>
        <a class="text-link" href="/services/">
          All services <span aria-hidden="true">→</span>
        </a>
      </header>

      <ol class="service-list">
        {services.map((service) => (
          <li>
            <span>{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="page-section shell kestrel-feature">
    <div class="kestrel-line" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div>
      <p class="eyebrow">Research focus</p>
      <h2>The Common Kestrel in Ireland.</h2>
      <p class="lede">
        Kez completed her PhD at Queen's University Belfast, researching the ecology of this familiar—but
        declining—small falcon.
      </p>
      <a class="text-link" href="/kestrels-ni/">
        Explore Kestrels NI <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <ContactPanel />
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: min(760px, calc(100vh - 7rem));
    padding-block: clamp(3rem, 7vw, 7rem);
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.75fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .hero-copy h1 {
    max-width: 11ch;
  }

  .hero-copy .lede {
    max-width: 36rem;
    margin-top: 1.7rem;
  }

  .hero-copy .button-row {
    margin-top: 2.2rem;
  }

  .hero-portrait {
    margin: 0;
  }

  .portrait-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--paper-deep);
  }

  .portrait-frame::before {
    position: absolute;
    z-index: 1;
    inset: 1rem;
    border: 1px solid rgb(245 242 233 / 0.72);
    content: "";
    pointer-events: none;
  }

  .portrait-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    border-bottom: 1px solid var(--line);
    color: var(--slate);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .proof-band {
    padding-block: 1.6rem;
    color: white;
    background: var(--teal-deep);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .proof-grid p {
    display: flex;
    min-height: 4rem;
    padding-inline: 1.5rem;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid rgb(245 242 233 / 0.22);
  }

  .proof-grid p:last-child {
    border-right: 1px solid rgb(245 242 233 / 0.22);
  }

  .proof-grid strong {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 560;
  }

  .proof-grid span {
    color: white;
    font-size: 0.7rem;
  }

  .introduction,
  .section-heading,
  .kestrel-feature {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .introduction h2 {
    max-width: 12ch;
  }

  .services-preview {
    padding-block: clamp(4rem, 9vw, 8rem);
    background: var(--paper-deep);
  }

  .section-heading {
    align-items: end;
  }

  .section-heading .text-link {
    justify-self: end;
  }

  .service-list {
    margin: 4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .service-list li {
    display: grid;
    padding-block: 2rem;
    grid-template-columns: 4rem 0.7fr 1.3fr;
    gap: 2rem;
    align-items: baseline;
    border-bottom: 1px solid var(--line);
  }

  .service-list li > span {
    color: var(--teal-deep);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .service-list p {
    color: var(--slate);
  }

  .kestrel-feature {
    align-items: center;
  }

  .kestrel-line {
    display: grid;
    height: 21rem;
    grid-template-columns: repeat(5, 1fr);
    align-items: end;
    gap: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .kestrel-line span {
    height: 35%;
    background: var(--teal-soft);
  }

  .kestrel-line span:nth-child(2) {
    height: 58%;
    background: var(--teal);
  }
  .kestrel-line span:nth-child(3) {
    height: 92%;
    background: var(--teal-deep);
  }
  .kestrel-line span:nth-child(4) {
    height: 68%;
    background: var(--ochre);
  }
  .kestrel-line span:nth-child(5) {
    height: 44%;
    background: var(--slate);
  }

  .kestrel-feature .lede {
    margin: 1.5rem 0;
  }

  @media (max-width: 760px) {
    .hero,
    .introduction,
    .section-heading,
    .kestrel-feature {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .proof-grid {
      grid-template-columns: 1fr 1fr;
    }

    .proof-grid p:nth-child(3) {
      border-top: 1px solid rgb(245 242 233 / 0.22);
    }

    .proof-grid p:nth-child(4) {
      border-top: 1px solid rgb(245 242 233 / 0.22);
      border-right: 1px solid rgb(245 242 233 / 0.22);
    }

    .service-list li {
      grid-template-columns: 2rem 1fr;
      gap: 0.8rem;
    }

    .service-list p {
      grid-column: 2;
    }

    .section-heading .text-link {
      justify-self: start;
    }

    .kestrel-line {
      height: 12rem;
    }
  }
</style>
