---
import ContactPanel from "@src/components/contact-panel/ContactPanel.astro";
import PageIntro from "@src/components/page-intro/PageIntro.astro";
import {services} from "@src/content/Services";
import BaseLayout from "@src/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Ornithology & ecology services"
  description="Specialist ornithological fieldwork, ecological reporting, GIS analysis and bird-ringing training across Ireland."
>
  <PageIntro
    eyebrow="Services"
    title="Specialist expertise, shaped around your project."
    summary="Bespoke freelance support for ornithological research, ecological fieldwork, technical reporting and training across the island of Ireland."
    width="wide"
  />

  <section class="shell services" aria-label="Consultancy services">
    {services.map((service) => (
      <article>
        <p class="service-number">{service.number}</p>
        <div>
          <h2>{service.title}</h2>
          <p class="lede">{service.description}</p>
        </div>
        <ul>
          {service.details.map((detail) => (
            <li>{detail}</li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <section class="page-section shell approach">
    <div>
      <p class="eyebrow">Working together</p>
      <h2>Clear scope. Sound evidence. Useful outcomes.</h2>
    </div>
    <div class="prose">
      <p>
        Every project starts with the ecological question and the evidence needed to answer it. Support can be
        focused on one specialist task or form part of a wider project team.
      </p>
      <p>
        If the work sits between the categories above, get in touch. The right approach can be shaped around
        the species, site, audience and reporting requirements involved.
      </p>
    </div>
  </section>

  <ContactPanel heading="Bring specialist ornithological experience into your project." />
</BaseLayout>

<style>
  .services {
    border-top: 1px solid var(--line);
  }

  .services article {
    display: grid;
    padding-block: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: 5rem minmax(0, 1.2fr) minmax(13rem, 0.55fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--line);
  }

  .service-number {
    color: var(--teal-deep);
    font-size: 0.75rem;
    font-weight: 760;
  }

  .services h2 {
    max-width: 13ch;
  }

  .services .lede {
    max-width: 38rem;
    margin-top: 1.25rem;
    font-size: clamp(1.1rem, 2vw, 1.42rem);
  }

  .services ul {
    margin: 0;
    padding: 0;
    align-self: end;
    list-style: none;
  }

  .services li {
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--line);
    color: var(--slate);
    font-size: 0.88rem;
  }

  .approach {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 7vw, 7rem);
  }

  @media (max-width: 700px) {
    .services article,
    .approach {
      grid-template-columns: 1fr;
    }

    .services article {
      gap: 1.5rem;
    }
  }
</style>
