---
import {Image} from "astro:assets";

import birdRinging from "@src/assets/images/bird-ringing-close-up.jpg";
import gullFieldwork from "@src/assets/images/fieldwork-gull-ringing.jpg";
import kestrelFieldwork from "@src/assets/images/kestrel-fieldwork.jpg";
import ContactPanel from "@src/components/contact-panel/ContactPanel.astro";
import PageIntro from "@src/components/page-intro/PageIntro.astro";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import {withBase} from "@src/site/Site";
---

<BaseLayout
  title="About"
  description="Meet Kez Armstrong, an ornithologist, bird ringer and ecologist working across the island of Ireland."
>
  <PageIntro
    eyebrow="About"
    title="An ecologist at home in the field."
    summary="I am an ecologist working across the island of Ireland, with extensive experience in ornithological research, fieldwork and reporting."
  />

  <section class="shell story-grid">
    <div class="story-image story-image--large">
      <Image
        src={gullFieldwork}
        alt="Kez Armstrong holding a gull during a bird-ringing field session"
        widths={[600, 900, 1200]}
        sizes="(max-width: 760px) 100vw, 48vw"
        format="avif"
      />
    </div>

    <div class="prose story-copy">
      <p>
        I completed my PhD at <a href="https://www.qub.ac.uk/">Queen's University Belfast</a> and have
        extensive experience as an ornithologist and ecologist with a range of projects across Ireland.
      </p>
      <p>
        I am an ornithologist and bird ringer working with various ringing groups across Ireland. I am the
        <a href="https://www.bto.org/community/regional-network">
          British Trust for Ornithology regional representative
        </a>
        for County Down.
      </p>
      <p>
        My work spans research, hands-on fieldwork, training and translating ecological evidence into clear,
        useful reporting.
      </p>
      <a class="text-link" href={withBase("/cv/")}>
        View full CV <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="page-section projects-section">
    <div class="shell">
      <header class="projects-heading">
        <div>
          <p class="eyebrow">Field experience</p>
          <h2>Bird-ringing projects across Ireland.</h2>
        </div>
        <p class="lede">
          I am a licensed BTO bird ringer and bird-ringing trainer working with the following projects.
        </p>
      </header>

      <div class="projects-grid">
        <ul class="project-list">
          <li>
            <strong>Causeway Coast Ringing Group</strong>
            <span>Passerine species, Constant Effort Site, Storm Petrels</span>
          </li>
          <li>
            <a href="https://www.irishbrentgoose.com/">
              <strong>Irish Brent Goose Research Group</strong>
              <span>Waterfowl species</span>
            </a>
          </li>
          <li>
            <a href="https://www.thecbo.org.uk/">
              <strong>Copeland Bird Observatory</strong>
              <span>Manx Shearwaters, passerine species</span>
            </a>
          </li>
          <li>
            <a href="https://www.nirsg.com/">
              <strong>NI Raptor Study Group</strong>
              <span>Raptors</span>
            </a>
          </li>
          <li>
            <strong>KRCEcological</strong>
            <span>Waders, waterfowl GPS tagging and colour ringing</span>
          </li>
          <li>
            <strong>Irish Midlands Ringing Group</strong>
            <span>Kestrels</span>
          </li>
        </ul>

        <div class="fieldwork-gallery">
          <figure>
            <Image
              src={kestrelFieldwork}
              alt="Kez Armstrong measuring a kestrel chick during fieldwork"
              widths={[480, 720, 960]}
              sizes="(max-width: 760px) 100vw, 37vw"
              format="avif"
            />
            <figcaption>Kestrel fieldwork during long-term raptor research.</figcaption>
          </figure>

          <figure class="fieldwork-gallery__detail">
            <Image
              src={birdRinging}
              alt="A small brown bird held carefully during a ringing session"
              widths={[360, 540, 720]}
              sizes="(max-width: 760px) 100vw, 28vw"
              format="avif"
              loading="lazy"
            />
            <figcaption>Careful handling during a bird-ringing session.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <ContactPanel heading="Need experienced field support?" />
</BaseLayout>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .story-image {
    overflow: hidden;
    background: var(--paper-deep);
  }

  .story-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-image--large {
    aspect-ratio: 4 / 5;
  }

  .story-copy .text-link {
    display: inline-block;
    margin-top: 2rem;
  }

  .projects-section {
    margin-top: clamp(4rem, 9vw, 8rem);
    background: var(--paper-deep);
  }

  .projects-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
  }

  .projects-heading .lede {
    font-size: clamp(1.1rem, 2vw, 1.42rem);
  }

  .projects-grid {
    display: grid;
    margin-top: 4rem;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .project-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .project-list li,
  .project-list a {
    display: block;
  }

  .project-list li {
    padding-block: 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .project-list a {
    text-decoration-color: var(--teal-deep);
  }

  .project-list strong,
  .project-list span {
    display: block;
  }

  .project-list span {
    margin-top: 0.3rem;
    color: var(--slate);
    font-size: 0.85rem;
  }

  figure {
    margin: 0;
  }

  .fieldwork-gallery {
    display: grid;
    align-content: start;
    gap: 2rem;
  }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .fieldwork-gallery__detail {
    width: 78%;
    margin-left: auto;
  }

  .fieldwork-gallery__detail :global(img) {
    aspect-ratio: 1 / 1;
  }

  figcaption {
    margin-top: 0.7rem;
    color: var(--slate);
    font-size: 0.76rem;
  }

  @media (max-width: 760px) {
    .story-grid,
    .projects-heading,
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
